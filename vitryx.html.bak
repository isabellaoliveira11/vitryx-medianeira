                description: "Eletricista residencial e comercial.", 
                catalog: [], address: "Bairro Nazaré", lat: -25.2900, lng: -54.0800, protectedLocation: false, origin: "Base Importada", validationStatus: "pendente", updatedAt: "2026-01-10", 
                tags: ["eletricista", "chuveiro", "fiação"], whatsapp: "(45) 97777-0003", color: "bg-amber-500", icon: "zap", stats: { views: 156, contacts: 8 }
            }
        ];

        const searchSynonyms = {
            "faxina": ["diarista", "limpeza", "casa"], "limpeza": ["diarista", "faxina", "casa"],
            "unha": ["manicure", "pedicure", "gel"], "esmalte": ["manicure", "unha"],
            "carro quebrado": ["mecânico", "oficina", "carro", "conserto"],
            "celular quebrado": ["celular", "assistência técnica", "conserto", "tela"],
            "reforma": ["construção", "pedreiro", "pintura"],
            "merenda": ["pnae", "agricultura familiar", "hortaliça"]
        };

        const initialDemands = [
            { id: 1, title: "Reparo de Carteiras e Mesas", sector: "Sec. Educação", category: "Serviços", tags: ["marcenaria", "conserto", "móveis"], cnae: "3101-2/00", date: "Jul/2026", desc: "Necessidade constante de reparo no mobiliário.", status: "Planejamento" },
            { id: 2, title: "Hortaliças para Merenda", sector: "Sec. Educação", category: "Alimentação", tags: ["agricultura familiar", "hortaliça", "pnae"], cnae: "0112-1/01", date: "Ago/2026", desc: "Levantamento PNAE.", status: "Em análise" }
        ];

        const appData = { businesses: [], validations: [], gaps: [], history: [], demands: [] };

        const storage = {
            init() {
                if (!localStorage.getItem('vitryx_demo_businesses')) this.reset();
                else {
                    appData.businesses = JSON.parse(localStorage.getItem('vitryx_demo_businesses'));
                    appData.validations = JSON.parse(localStorage.getItem('vitryx_demo_validations'));
                    appData.gaps = JSON.parse(localStorage.getItem('vitryx_demo_gaps'));
                    appData.history = JSON.parse(localStorage.getItem('vitryx_demo_history') || '[]');
                    appData.demands = JSON.parse(localStorage.getItem('vitryx_demo_demands') || '[]');
                }
            },
            save() {
                localStorage.setItem('vitryx_demo_businesses', JSON.stringify(appData.businesses));
                localStorage.setItem('vitryx_demo_validations', JSON.stringify(appData.validations));
                localStorage.setItem('vitryx_demo_gaps', JSON.stringify(appData.gaps));
                localStorage.setItem('vitryx_demo_history', JSON.stringify(appData.history));
                localStorage.setItem('vitryx_demo_demands', JSON.stringify(appData.demands));
            },
            reset() {
                appData.businesses = JSON.parse(JSON.stringify(seedBusinesses));
                appData.validations = [];
                appData.gaps = [ { term: "conserto de projetor", count: 18, status: "Nenhuma" }, { term: "manutenção de elevador", count: 12, status: "Nenhuma" } ];
                appData.history = [ { date: new Date().toISOString(), user: 'Sistema', action: 'Importação Inicial', detail: 'Base carregada com sucesso.' } ];
                appData.demands = JSON.parse(JSON.stringify(initialDemands));
                this.save();
            }
        };

        const app = {
            currentPersona: 'citizen', currentLayout: 'public', currentView: 'landing', currentSearchTerm: '', radarFilter: 'all',
            mobileMapVisible: false, leafletMap: null, mapMarkers: [], mgrLeafletMap: null, loggedInBusinessId: 1,
            onboardingStep: 0, onboardingType: 'new', currentTags: [], currentEditTags: [], currentDemandTags: [], currentUploadedFile: null,

            init() {
                try {
                    storage.init();
                    if(typeof lucide !== 'undefined') lucide.createIcons();
                    this.switchPersona('citizen');
                    if(typeof vitoriaAssistant !== 'undefined') vitoriaAssistant.init();
                    this.updateBusinessSelector();
                } catch(e) { console.error("Init Error:", e); }
            },

            updateBusinessSelector() {
                const select = document.getElementById('ent-business-selector');
                if(select) {
                    select.innerHTML = appData.businesses.map(b => `<option value="${b.id}">${b.name}</option>`).join('');
                    select.value = this.loggedInBusinessId;
                }
            },

            navigate(layoutId, viewId) {
                if(this.currentLayout !== layoutId) {
                    document.querySelectorAll('.app-layout').forEach(el => el.classList.remove('active'));
                    document.getElementById(`layout-${layoutId}`).classList.add('active');
                    this.currentLayout = layoutId;
                }
                this.closeSidebars();
                document.querySelectorAll(`#layout-${layoutId} .app-view`).forEach(el => el.classList.remove('active', 'flex-active'));
                
                const prefix = layoutId === 'public' ? 'public-' : (layoutId === 'entrepreneur' ? 'ent-' : 'mgr-');
                const target = document.getElementById(`view-${prefix}${viewId}`);
                
                if (target) {
                    if(layoutId === 'public' && viewId === 'radar') target.classList.add('flex-active');
                    else target.classList.add('active');
                }
                this.currentView = viewId;

                if(layoutId === 'entrepreneur') this.updateSidebar('nav-entrepreneur', viewId, 'ent-topbar-title');
                if(layoutId === 'manager') this.updateSidebar('nav-manager', viewId, 'mgr-topbar-title');

                if (layoutId === 'public' && viewId === 'radar') {
                    this.renderRadar();
                    setTimeout(() => { this.initMap(); if(this.leafletMap) this.leafletMap.invalidateSize(); }, 100);
                }
                if(layoutId === 'entrepreneur') this.renderEntView(viewId);
                if (layoutId === 'manager') {
                    this.renderMgrView(viewId);
                    if (viewId === 'map') setTimeout(() => { this.initMgrMap(); }, 100);
                }
                window.scrollTo(0, 0);
                setTimeout(() => { if(typeof lucide !== 'undefined') lucide.createIcons(); }, 50);
            },

            updateSidebar(navId, viewId, titleId) {
                const nav = document.getElementById(navId);
                if(!nav) return;
                nav.querySelectorAll('button').forEach(btn => {
                    if(btn.dataset.target === viewId) {
                        btn.classList.add('bg-slate-100', 'text-brand-700', 'font-bold');
                        btn.classList.remove('text-slate-600', 'text-slate-300', 'text-slate-400');
                        const titleEl = document.getElementById(titleId);
                        if(titleEl) titleEl.innerText = btn.innerText.replace(/[0-9]/g,'').trim();
                    } else {
                        btn.classList.remove('bg-slate-100', 'text-brand-700', 'font-bold');
                    }
                });
            },

            toggleSidebar(type) {
                const sidebar = document.getElementById(`${type}-sidebar`);
                const overlay = document.getElementById(`${type}-sidebar-overlay`);
                if (sidebar.classList.contains('open')) { sidebar.classList.remove('open'); overlay.classList.remove('active'); } 
                else { sidebar.classList.add('open'); overlay.classList.add('active'); }
            },
            
            closeSidebars() {
                const ent = document.getElementById('ent-sidebar'), mgr = document.getElementById('mgr-sidebar');
                if(ent) ent.classList.remove('open'); if(mgr) mgr.classList.remove('open');
                document.querySelectorAll('.sidebar-overlay').forEach(el => el.classList.remove('active'));
            },

            renderTags(type) {
                const container = document.getElementById(type === 'onb' ? 'onb-tags-container' : (type === 'edit' ? 'edit-tags-container' : 'dem-tags-container'));
                const input = document.getElementById(type === 'onb' ? 'onb-tag-input' : (type === 'edit' ? 'edit-tag-input' : 'dem-tag-input'));
                if(!container || !input) return;
                
                const tagsArray = type === 'onb' ? this.currentTags : (type === 'edit' ? this.currentEditTags : this.currentDemandTags);
                
                // Keep the input, remove existing tags
                Array.from(container.children).forEach(c => { if(c.tagName !== 'INPUT') c.remove(); });
                
                tagsArray.forEach((tag, idx) => {
                    const tagEl = document.createElement('span');
                    tagEl.className = 'flex items-center gap-1 bg-brand-100 text-brand-700 px-2 py-1 rounded-md text-xs font-semibold shadow-sm';
                    tagEl.innerHTML = `${tag} <button onclick="app.removeTag('${type}', ${idx})" class="hover:text-brand-900 ml-1">&times;</button>`;
                    container.insertBefore(tagEl, input);
                });
            },

            handleTagInput(e, type) {
                if(e.key === 'Enter') {
                    e.preventDefault();
                    const val = e.target.value.trim().toLowerCase();
                    const tagsArray = type === 'onb' ? this.currentTags : (type === 'edit' ? this.currentEditTags : this.currentDemandTags);
                    if(val && !tagsArray.includes(val)) {
                        tagsArray.push(val);
                        e.target.value = '';
                        this.renderTags(type);
                    }
                }
            },

            removeTag(type, idx) {
                if(type === 'onb') this.currentTags.splice(idx, 1);
                else if(type === 'edit') this.currentEditTags.splice(idx, 1);
                else this.currentDemandTags.splice(idx, 1);
                this.renderTags(type);
            },

            maskCpfCnpj(input) {
                let v = input.value.replace(/\D/g, "");
                if (v.length <= 11) {
                    v = v.replace(/(\d{3})(\d)/, "$1.$2");
                    v = v.replace(/(\d{3})(\d)/, "$1.$2");
                    v = v.replace(/(\d{3})(\d{1,2})$/, "$1-$2");
                } else {
                    v = v.replace(/^(\d{2})(\d)/, "$1.$2");
                    v = v.replace(/^(\d{2})\.(\d{3})(\d)/, "$1.$2.$3");
                    v = v.replace(/\.(\d{3})(\d)/, ".$1/$2");
                    v = v.replace(/(\d{4})(\d)/, "$1-$2");
                }
                input.value = v;
                this.validateDoc(input);
            },

            validateDoc(input) {
                const err = document.getElementById(input.id + '-error');
                const clean = input.value.replace(/\D/g, '');
                
                let isValid = true;
                if (clean.length > 0) {
                    if (clean.length === 11) isValid = this.isValidCPF(clean);
                    else if (clean.length === 14) isValid = true; // Mock CNPJ valid
                    else isValid = false;
                }

                if(!isValid && clean.length > 0) {
                    input.classList.add('input-error');
                    if(err) err.classList.remove('hidden');
                    return false;
                }
                
                input.classList.remove('input-error');
                if(err) err.classList.add('hidden');
                return true;
            },

            maskPhone(input) {
                let v = input.value.replace(/\D/g, "");
                v = v.replace(/^(\d{2})(\d)/g, "($1) $2");
                v = v.replace(/(\d)(\d{4})$/, "$1-$2");
                input.value = v;
                
                const err = document.getElementById(input.id + '-error');
                if(v.length > 0 && v.replace(/\D/g,'').length < 10) {
                    input.classList.add('input-error');
                    if(err) err.classList.remove('hidden');
                } else {
                    input.classList.remove('input-error');
                    if(err) err.classList.add('hidden');
                }
            },

            maskCEP(input) {
                let v = input.value.replace(/\D/g, "");
                v = v.replace(/^(\d{5})(\d)/, "$1-$2");
                input.value = v;
            },

            generateHoursUI(containerId, data = null) {
                const container = document.getElementById(containerId);
                if(!container) return;
                
                const days = [
                    {k: 'seg', n: 'Segunda'}, {k: 'ter', n: 'Terça'}, {k: 'qua', n: 'Quarta'}, 
                    {k: 'qui', n: 'Quinta'}, {k: 'sex', n: 'Sexta'}, {k: 'sab', n: 'Sábado'}, {k: 'dom', n: 'Domingo'}
                ];
                
                // Fallback default
                const def = {o: true, s: '08:00', e: '18:00'};
                const current = data || {seg:def, ter:def, qua:def, qui:def, sex:def, sab:{o:false,s:'',e:''}, dom:{o:false,s:'',e:''}};

                container.innerHTML = days.map(d => {
                    const c = current[d.k] || {o:false, s:'', e:''};
                    return `
                        <div class="flex items-center gap-2 mb-2">
                            <span class="w-20 text-sm font-semibold text-slate-700">${d.n}</span>
                            <div class="relative inline-block w-10 mr-2 align-middle select-none transition duration-200 ease-in">
                                <input type="checkbox" id="h-chk-${containerId}-${d.k}" ${c.o ? 'checked' : ''} onchange="app.toggleHourRow('${containerId}', '${d.k}')" class="toggle-checkbox absolute block w-5 h-5 rounded-full bg-white border-4 appearance-none cursor-pointer"/>
                                <label for="h-chk-${containerId}-${d.k}" class="toggle-label block overflow-hidden h-5 rounded-full bg-slate-300 cursor-pointer"></label>
                            </div>
                            <div class="flex items-center gap-1 ${c.o ? '' : 'opacity-30 pointer-events-none'}" id="h-row-${containerId}-${d.k}">
                                <input type="time" id="h-s-${containerId}-${d.k}" value="${c.s}" class="px-2 py-1 text-sm bg-white border border-slate-200 rounded outline-none w-24">
                                <span class="text-xs text-slate-500">às</span>
                                <input type="time" id="h-e-${containerId}-${d.k}" value="${c.e}" class="px-2 py-1 text-sm bg-white border border-slate-200 rounded outline-none w-24">
                            </div>
                        </div>
                    `;
                }).join('');
            },

            toggleHourRow(containerId, dayKey) {
                const chk = document.getElementById(`h-chk-${containerId}-${dayKey}`).checked;
                const row = document.getElementById(`h-row-${containerId}-${dayKey}`);
                if(chk) row.classList.remove('opacity-30', 'pointer-events-none');
                else row.classList.add('opacity-30', 'pointer-events-none');
            },

            applyHoursToWeek(type = 'edit') {
                const cid = type === 'onb' ? 'onb-weekly-hours' : 'weekly-hours-container';
                const baseO = document.getElementById(`h-chk-${cid}-seg`).checked;
                const baseS = document.getElementById(`h-s-${cid}-seg`).value;
                const baseE = document.getElementById(`h-e-${cid}-seg`).value;

                ['ter', 'qua', 'qui', 'sex'].forEach(d => {
                    document.getElementById(`h-chk-${cid}-${d}`).checked = baseO;
                    document.getElementById(`h-s-${cid}-${d}`).value = baseS;
                    document.getElementById(`h-e-${cid}-${d}`).value = baseE;
                    this.toggleHourRow(cid, d);
                });
                this.showToast("Horário aplicado de Segunda a Sexta.", "success");
            },

            extractHoursData(containerId) {
                const res = {};
                ['seg', 'ter', 'qua', 'qui', 'sex', 'sab', 'dom'].forEach(d => {
                    res[d] = {
                        o: document.getElementById(`h-chk-${containerId}-${d}`).checked,
                        s: document.getElementById(`h-s-${containerId}-${d}`).value,
                        e: document.getElementById(`h-e-${containerId}-${d}`).value
                    };
                });
                return res;
            },

            formatHoursDisplay(hours) {
                if(!hours) return 'Horário não informado';
                const days = [
                    {k: 'seg', n: 'Segunda'}, {k: 'ter', n: 'Terça'}, {k: 'qua', n: 'Quarta'}, 
                    {k: 'qui', n: 'Quinta'}, {k: 'sex', n: 'Sexta'}, {k: 'sab', n: 'Sábado'}, {k: 'dom', n: 'Domingo'}
                ];
                
                // Very basic grouping logic for demo: group Mon-Fri if identical
                let html = '';
                const m2fMatch = ['seg','ter','qua','qui','sex'].every(d => 
                    hours[d].o === hours.seg.o && hours[d].s === hours.seg.s && hours[d].e === hours.seg.e
                );

                if(m2fMatch) {
                    html += `<div><span class="font-semibold text-slate-800">Segunda a Sexta</span> — ${hours.seg.o ? `${hours.seg.s} às ${hours.seg.e}` : 'Fechado'}</div>`;
                    ['sab', 'dom'].forEach(d => {
                        const label = d==='sab'?'Sábado':'Domingo';
                        html += `<div><span class="font-semibold text-slate-800">${label}</span> — ${hours[d].o ? `${hours[d].s} às ${hours[d].e}` : 'Fechado'}</div>`;
                    });
                } else {
                    days.forEach(d => {
                        html += `<div><span class="font-semibold text-slate-800">${d.n}</span> — ${hours[d.k].o ? `${hours[d.k].s} às ${hours[d.k].e}` : 'Fechado'}</div>`;
                    });
                }
                return html;
            },

            startOnboarding() {
                const modal = document.getElementById('modal-onboarding');
                const content = document.getElementById('modal-onboarding-content');
                this.onboardingStep = 0;
                this.currentTags = [];
                this.currentUploadedFile = null;
                document.getElementById('onb-file-text').innerText = "Clique para enviar arquivo";
                this.renderOnboardingStep();
                modal.classList.add('active');
                setTimeout(() => content.classList.replace('scale-95', 'scale-100'), 10);
            },

            setOnboardingType(type) {
                this.onboardingType = type;
                document.getElementById('onb-title').innerText = type === 'claim' ? 'Reivindicar Perfil' : 'Novo Cadastro';
                this.nextOnboardingStep();
            },

            nextOnboardingStep() {
                if(this.onboardingStep === 1) {
                    // Quick validation demo
                    const doc = document.getElementById('onb-doc');
                    const phone = document.getElementById('onb-phone');
                    const name = document.getElementById('onb-legal-name');
                    const vName = document.getElementById('onb-name');
                    if(!doc.value || !phone.value || !name.value || !vName.value || doc.classList.contains('input-error') || phone.classList.contains('input-error')) {
                        return this.showToast("Preencha corretamente os campos obrigatórios (*).", "error");
                    }
                }
                if(this.onboardingStep === 2) {
                    if(!this.currentUploadedFile) return this.showToast("Envie o comprovante de vínculo (*).", "error");
                    if(!document.getElementById('onb-address').value) return this.showToast("Preencha o endereço completo.", "error");
                    this.generateHoursUI('onb-weekly-hours');
                    this.renderTags('onb');
                }
                if(this.onboardingStep === 3) {
                    this.submitOnboarding();
                    return;
                }
                this.onboardingStep++;
                this.renderOnboardingStep();
            },

            prevOnboardingStep() {
                if(this.onboardingStep > 0) this.onboardingStep--;
                this.renderOnboardingStep();
            },

            renderOnboardingStep() {
                document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active'));
                document.getElementById(`onb-step-${this.onboardingStep}`).classList.add('active');
                
                const footer = document.getElementById('onb-footer');
                if(this.onboardingStep === 0) {
                    footer.classList.add('hidden');
                } else {
                    footer.classList.remove('hidden');
                    document.getElementById('onb-btn-next').innerText = this.onboardingStep === 3 ? 'Enviar Solicitação' : 'Continuar';
                    document.getElementById('onb-btn-next').disabled = (this.onboardingStep === 3 && !document.getElementById('onb-lgpd').checked);
                }
            },

            handleFileUpload(input) {
                if(input.files && input.files[0]) {
                    this.currentUploadedFile = { name: input.files[0].name, type: input.files[0].type || 'Desconhecido' };
                    document.getElementById('onb-file-text').innerHTML = `<span class="text-emerald-600 font-bold">${this.currentUploadedFile.name} (Anexado)</span>`;
                    document.getElementById('onb-file-icon').classList.replace('text-slate-400', 'text-emerald-500');
                    document.getElementById('onb-file-icon').setAttribute('data-lucide', 'file-check');
                    if(typeof lucide !== 'undefined') lucide.createIcons();
                }
            },

            submitOnboarding() {
                const name = document.getElementById('onb-name').value || "Novo Empreendedor";
                const data = {
                    name: name,
                    category: document.getElementById('onb-category').value,
                    type: document.getElementById('onb-type').value,
                    porte: document.getElementById('onb-porte').value,
                    cnae: document.getElementById('onb-cnae').value,
                    address: document.getElementById('onb-address').value,
                    protectedLocation: document.getElementById('onb-protected').checked,
                    whatsapp: document.getElementById('onb-phone').value,
                    description: document.getElementById('onb-desc').value,
                    tags: this.currentTags,
                    hours: this.extractHoursData('onb-weekly-hours'),
                    file: this.currentUploadedFile
                };

                appData.validations.push({
                    id: Date.now(),
                    businessId: null, // New
                    businessName: name,
                    type: this.onboardingType === 'claim' ? "Reivindicação de Perfil" : "Novo Cadastro",
                    changes: {},
                    onboardingData: data,
                    status: "pending",
                    date: new Date().toISOString()
                });
                
                this.addHistory(this.onboardingType === 'claim' ? 'Reivindicação' : 'Solicitação de Cadastro', name);
                storage.save();
                
                this.closeModal('modal-onboarding');
                this.showToast('Solicitação enviada para a Prefeitura!', 'success');
            },

            openLoginModal(type) {
                const modalId = type === 'entrepreneur' ? 'modal-login-ent' : 'modal-login-mgr';
                const modal = document.getElementById(modalId);
                const content = document.getElementById(modalId + '-content');
                modal.classList.add('active');
                setTimeout(() => content.classList.replace('scale-95', 'scale-100'), 10);
            },

            executeLogin(type) {
                this.closeModal(type === 'entrepreneur' ? 'modal-login-ent' : 'modal-login-mgr');
                this.switchPersona(type);
                this.showToast(`Acesso demonstrativo autorizado.`, 'success');
            },

            switchPersona(persona) {
                this.currentPersona = persona;
                ['citizen', 'entrepreneur', 'manager'].forEach(p => {
                    const btn = document.getElementById(`btn-persona-${p}`);
                    if(btn) {
                        if(p === persona) {
                            btn.classList.replace('text-slate-400', 'text-white');
                            btn.classList.add('bg-slate-600');
                        } else {
                            btn.classList.replace('text-white', 'text-slate-400');
                            btn.classList.remove('bg-slate-600');
                        }
                    }
                });

                if(persona === 'citizen') this.navigate('public', 'landing');
                if(persona === 'entrepreneur') this.navigate('entrepreneur', 'overview');
                if(persona === 'manager') this.navigate('manager', 'overview');
                if(typeof vitoriaAssistant !== 'undefined') vitoriaAssistant.updateContext(persona);
            },

            resetDemo() {
                storage.reset();
                this.updateBusinessSelector();
                this.showToast('Dados de demonstração restaurados.', 'success');
                if(this.currentPersona === 'entrepreneur') this.renderEntView(this.currentView);
                if(this.currentPersona === 'manager') this.renderMgrView(this.currentView);
                if(this.currentPersona === 'citizen' && this.currentView === 'radar') this.renderRadar();
            },

            adjustFontSize(delta) {
                const body = document.getElementById('app-body');
                let currentSize = parseFloat(window.getComputedStyle(body, null).getPropertyValue('font-size'));
                body.style.fontSize = (currentSize + delta) + 'px';
            },

            toggleHighContrast() {
                document.getElementById('app-body').classList.toggle('invert');
                document.getElementById('app-body').classList.toggle('hue-rotate-180');
            },

            openModal(id) {
                const modal = document.getElementById(id);
                const content = document.getElementById(id + '-content');
                if(modal && content) {
                    modal.classList.add('active');
                    setTimeout(() => content.classList.replace('scale-95', 'scale-100'), 10);
                }
            },

            closeModal(id) {
                const modal = document.getElementById(id);
                if(modal) {
                    const content = modal.querySelector('div');
                    if(content) content.classList.replace('scale-100', 'scale-95');
                    setTimeout(() => modal.classList.remove('active'), 200);
                }
            },

            simulateVoiceSearch() {
                this.showToast("Demonstração: Ouvindo...", "info");
                setTimeout(() => {
                    const input = document.getElementById('landing-search') || document.getElementById('radar-search');
                    if(input) { input.value = "costura"; app.doSearch(input.id); }
                }, 2000);
            },

            forceSearch(term) {
                const input = document.getElementById('landing-search');
                if(input) { input.value = term; this.doSearch('landing-search'); }
            },

            doSearch(inputId) {
                const el = document.getElementById(inputId);
                const term = el ? el.value.trim() : '';
                this.currentSearchTerm = term;
                const rSearch = document.getElementById('radar-search');
                if(rSearch) rSearch.value = term;
                
                const results = this.searchEngine(term);
                if(term && results.length === 0) {
                    this.addGapToManager(term);
                } else {
                    results.forEach(r => { if(r.stats) r.stats.views++; });
                    storage.save();
                }
                this.navigate('public', 'radar');
            },

            searchEngine(query) {
                if (!query) return appData.businesses;
                const q = query.toLowerCase().trim();
                let searchTerms = [q];
                for (const [key, syns] of Object.entries(searchSynonyms)) {
                    if (q.includes(key) || syns.some(s => q.includes(s))) {
                        searchTerms.push(key, ...syns);
                    }
                }
                
                return appData.businesses.filter(b => {
                    let matchFound = false;
                    b.matchReason = "";
                    const bName = b.name.toLowerCase();
                    const bCat = b.category.toLowerCase();
                    const bTags = b.tags.join(' ').toLowerCase();
                    const bCatStr = (b.catalog || []).map(c => c.name.toLowerCase()).join(' ');

                    for (const term of searchTerms) {
                        if (bName.includes(term)) { matchFound = true; b.matchReason = "Nome da empresa"; break; }
                        if (bCatStr.includes(term)) { matchFound = true; b.matchReason = `Catálogo`; break; }
                        if (bCat.includes(term)) { matchFound = true; b.matchReason = `Categoria relacionada`; break; }
                        if (bTags.includes(term)) { matchFound = true; b.matchReason = `Tag: ${term}`; break; }
                    }
                    return matchFound && b.validationStatus === 'validado';
                });
            },

            addGapToManager(term) {
                const lower = term.toLowerCase().trim();
                if(!lower) return;
                const existing = appData.gaps.find(g => g.term === lower);
                if(existing) existing.count++;
                else {
                    appData.gaps.push({ term: lower, count: 1, status: "Registrado agora" });
                    this.addHistory("Lacuna Identificada", lower);
                }
                storage.save();
            },

            filterRadar(type) {
                this.radarFilter = type;
                this.renderRadar();
            },

            renderRadar() {
                const resultsContainer = document.getElementById('radar-results');
                if(!resultsContainer) return;
                let results = this.searchEngine(this.currentSearchTerm);
                
                if (this.radarFilter === 'open') results = results.filter(b => b.status === 'aberto');
                if (this.radarFilter === 'urban') results = results.filter(b => b.type === 'urban');
                if (this.radarFilter === 'rural') results = results.filter(b => b.type === 'rural');
                if (this.radarFilter === 'professional') results = results.filter(b => b.type === 'professional');
                
                resultsContainer.innerHTML = '';

                if (results.length === 0) {
                    resultsContainer.innerHTML = `
                        <div class="bg-brand-50 border border-brand-200 rounded-xl p-6 text-center shadow-sm mt-4">
                            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-sm text-brand-600"><i data-lucide="radar" class="w-6 h-6"></i></div>
                            <h3 class="font-bold text-slate-900 mb-2">Demanda Registrada!</h3>
                            <p class="text-sm text-slate-600 mb-4">Não encontramos locais para <strong>"${this.currentSearchTerm}"</strong>. A Prefeitura mapeou sua necessidade para atrair novos fornecedores.</p>
                            <button onclick="app.startOnboarding()" class="bg-brand-600 text-white px-6 py-2 rounded-xl text-sm font-bold shadow-sm hover:bg-brand-700">Eu ofereço isso!</button>
                        </div>
                    `;
                    this.updateMapMarkers([]);
                    if(typeof lucide !== 'undefined') lucide.createIcons();
                    return;
                }

                results.forEach(b => {
                    let iconName = b.type === 'urban' ? 'store' : (b.type === 'rural' ? 'tractor' : 'user');
                    const statusColor = b.status === 'aberto' ? 'bg-emerald-500' : 'bg-slate-300';
                    const whyBadge = this.currentSearchTerm && b.matchReason ? `<div class="mt-2.5 inline-flex items-center gap-1 px-2 py-1 bg-orange-50 border border-orange-100 rounded text-[10px] font-semibold text-orange-700"><i data-lucide="sparkles" class="w-3 h-3"></i> ${b.matchReason}</div>` : '';

                    resultsContainer.insertAdjacentHTML('beforeend', `
                        <div onclick="app.panToAndOpen(${b.id})" class="bg-white border border-slate-200 rounded-2xl p-4 cursor-pointer hover:border-brand-400 hover:shadow-md transition-all flex flex-col group">
                            <div class="flex gap-4">
                                <div class="w-14 h-14 rounded-xl ${b.color} flex items-center justify-center text-white flex-shrink-0 font-bold text-xl shadow-sm"><i data-lucide="${iconName}" class="w-6 h-6"></i></div>
                                <div class="flex-grow min-w-0">
                                    <div class="flex justify-between items-start">
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide truncate">${b.category}</p>
                                        <div class="w-2 h-2 rounded-full ${statusColor}"></div>
                                    </div>
                                    <h3 class="font-bold text-slate-900 text-base truncate group-hover:text-brand-600 transition-colors">${b.name}</h3>
                                    <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">${b.description}</p>
                                </div>
                            </div>
                            ${whyBadge}
                        </div>
                    `);
                });
                
                this.updateMapMarkers(results);
                if(this.leafletMap && this.mapMarkers.length > 0) {
                    const group = new L.featureGroup(this.mapMarkers);
                    this.leafletMap.fitBounds(group.getBounds().pad(0.1));
                }
                if(typeof lucide !== 'undefined') lucide.createIcons();
            },

            initMap() {
                if(this.leafletMap || !document.getElementById('map')) return;
                this.leafletMap = L.map('map', {zoomControl: false}).setView([-25.2983, -54.0933], 14);
                L.control.zoom({ position: 'bottomleft' }).addTo(this.leafletMap);
                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { attribution: '&copy; OSM', subdomains: 'abcd', maxZoom: 19 }).addTo(this.leafletMap);
                this.updateMapMarkers(appData.businesses.filter(b=>b.validationStatus==='validado'));
            },

            updateMapMarkers(results) {
                if(!this.leafletMap) return;
                this.mapMarkers.forEach(m => this.leafletMap.removeLayer(m));
                this.mapMarkers = [];

                results.forEach(b => {
                    let iconName = b.type === 'urban' ? 'store' : (b.type === 'rural' ? 'tractor' : 'user');
                    if(!b.protectedLocation) {
                        const customIcon = L.divIcon({
                            className: 'custom-div-icon',
                            html: `<div class="w-10 h-10 ${b.color} rounded-full flex items-center justify-center text-white shadow-lg border-2 border-white transform transition-transform hover:scale-110"><i data-lucide="${iconName}" class="w-5 h-5"></i></div>`,
                            iconSize: [40, 40], iconAnchor: [20, 40], popupAnchor: [0, -40]
                        });
                        const marker = L.marker([b.lat, b.lng], {icon: customIcon}).addTo(this.leafletMap);
                        marker.bindPopup(this.createPopupHTML(b));
                        this.mapMarkers.push(marker);
                    } else {
                        const circle = L.circle([b.lat, b.lng], { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.2, radius: 200, weight: 2 }).addTo(this.leafletMap);
                        circle.bindPopup(this.createPopupHTML(b));
                        this.mapMarkers.push(circle);
                    }
                });
                setTimeout(() => { if(typeof lucide !== 'undefined') lucide.createIcons(); }, 50);
            },

            createPopupHTML(b) {
                const statusColor = b.status === 'aberto' ? 'text-emerald-700 bg-emerald-50' : 'text-slate-500 bg-slate-100';
                const statusText = b.status === 'aberto' ? `Aberto` : 'Fechado';
                const locNote = b.protectedLocation ? `<div class="text-[9px] text-amber-700 bg-amber-50 rounded px-1 mt-1 font-bold">Localização Aproximada</div>` : '';
                return `
                    <div class="p-4 bg-white">
                        <p class="text-[10px] font-bold text-slate-400 uppercase mb-1">${b.category}</p>
                        <h3 class="font-bold text-slate-900 text-base leading-tight mb-2">${b.name}</h3>
                        <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold ${statusColor} mb-3 border border-slate-100">
                            <div class="w-1.5 h-1.5 rounded-full ${b.status==='aberto'?'bg-emerald-500':'bg-slate-400'}"></div>${statusText}
                        </div>
                        ${locNote}
                        <div class="flex gap-2 mt-2">
                            <button onclick="app.openProfile(${b.id})" class="flex-1 bg-brand-50 hover:bg-brand-100 text-brand-700 text-xs font-bold py-2 rounded-lg transition text-center">Ver Vitrine</button>
                        </div>
                    </div>
                `;
            },

            panToAndOpen(id) {
                if(window.innerWidth < 768 && !this.mobileMapVisible) {
                    this.openProfile(id);
                } else {
                    const b = appData.businesses.find(x => x.id === id);
                    if(b && this.leafletMap) {
                        this.leafletMap.setView([b.lat, b.lng], 15);
                        const layer = this.mapMarkers.find(m => {
                            if(m instanceof L.Marker || m instanceof L.Circle) return m.getLatLng().lat === b.lat && m.getLatLng().lng === b.lng;
                            return false;
                        });
                        if(layer) layer.openPopup();
                    }
                }
            },

            toggleMobileMap() {
                this.mobileMapVisible = !this.mobileMapVisible;
                const sidebar = document.getElementById('radar-sidebar'), mapArea = document.getElementById('radar-map-area'), btn = document.getElementById('mobile-map-toggle');
                
                if (this.mobileMapVisible) {
                    sidebar.style.display = 'none'; mapArea.style.display = 'block';
                    btn.innerHTML = '<i data-lucide="list" class="w-5 h-5"></i> Mostrar Lista';
                    btn.classList.replace('bg-slate-900', 'bg-brand-600');
                    setTimeout(() => { if(this.leafletMap) this.leafletMap.invalidateSize(); }, 100);
                } else {
                    sidebar.style.display = 'flex'; mapArea.style.display = 'none';
                    btn.innerHTML = '<i data-lucide="map" class="w-5 h-5"></i> Mostrar Mapa';
                    btn.classList.replace('bg-brand-600', 'bg-slate-900');
                }
                if(typeof lucide !== 'undefined') lucide.createIcons();
            },

            openProfile(id) {
                const b = appData.businesses.find(x => x.id === id);
                if(!b) return;

                document.getElementById('profile-cover-img').src = `https://placehold.co/800x400/${b.color.split('-')[1] || 'slate'}/ffffff?text=Capa`;
                document.getElementById('profile-logo-text').innerText = b.name.charAt(0);
                
                let iconName = b.type === 'urban' ? 'store' : (b.type === 'rural' ? 'tractor' : 'user');
                document.getElementById('profile-type-icon').innerHTML = `<i data-lucide="${iconName}" class="w-4 h-4"></i>`;

                document.getElementById('profile-name').innerText = b.name;
                document.getElementById('profile-category').innerText = b.category;
                document.getElementById('profile-description').innerText = b.description;
                document.getElementById('profile-hours').innerHTML = this.formatHoursDisplay(b.hours);
                
                const vBadge = document.getElementById('profile-verified-badge');
                if(b.validationStatus === 'validado') vBadge.classList.remove('hidden'); else vBadge.classList.add('hidden');

                const statusColor = b.status === 'aberto' ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-slate-600 bg-slate-100 border-slate-200';
                document.getElementById('profile-status-badge').innerHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold ${statusColor} border shadow-sm"><div class="w-2 h-2 rounded-full ${b.status==='aberto'?'bg-emerald-500':'bg-slate-400'}"></div>${b.status==='aberto'?'Aberto':'Fechado'}</span>`;

                document.getElementById('profile-address').innerHTML = b.protectedLocation ? 
                    `${b.address.split(',')[0]} (Área Aproximada) <br><span class="inline-block mt-2 text-xs text-amber-700 font-bold bg-amber-50 px-2 py-1 rounded border border-amber-200"><i data-lucide="shield" class="w-3 h-3 inline"></i> Endereço exato preservado por privacidade.</span>` : 
                    b.address;

                const catContainer = document.getElementById('profile-catalog');
                const catEmpty = document.getElementById('profile-catalog-empty');
                if(b.catalog && b.catalog.length > 0) {
                    catEmpty.classList.add('hidden'); catContainer.classList.remove('hidden');
                    catContainer.innerHTML = b.catalog.map(item => `
                        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition">
                            <div class="h-28 bg-slate-100 relative"><img src="${item.img || `https://placehold.co/400x300/e2e8f0/475569?text=Item`}" class="w-full h-full object-cover"></div>
                            <div class="p-3"><h4 class="text-xs font-bold text-slate-900 line-clamp-1">${item.name}</h4><p class="text-xs text-brand-600 font-bold mt-1">${item.price}</p></div>
                        </div>
                    `).join('');
                } else {
                    catContainer.classList.add('hidden'); catEmpty.classList.remove('hidden');
                }

                document.getElementById('profile-origin').innerText = b.origin || 'Base';
                document.getElementById('profile-validation').innerText = b.validationStatus.charAt(0).toUpperCase() + b.validationStatus.slice(1);
                document.getElementById('profile-updated').innerText = b.updatedAt;

                if(typeof lucide !== 'undefined') lucide.createIcons();
                this.navigate('public', 'profile');
            },

            actionWhatsApp() { this.showToast("Demonstração: Abrindo WhatsApp...", "success"); },
            actionCall() { this.showToast("Demonstração: Iniciando chamada...", "success"); },
            actionRoute() { this.showToast("Demonstração: Abrindo Rota...", "success"); },
            shareProfile() {
                if(navigator.share) navigator.share({ title: 'Vitryx', url: window.location.href }).catch(console.error);
                else this.showToast("Link copiado para a área de transferência!", "success");
            },

            viewMyProfilePublicly() {
                if (this.loggedInBusinessId) {
                    this.switchPersona('citizen');
                    this.openProfile(this.loggedInBusinessId);
                    if(typeof vitoriaAssistant !== 'undefined') vitoriaAssistant.close();
                } else this.showToast('Nenhuma empresa vinculada ao seu perfil.', 'error');
            },

            loginAs(id) {
                this.loggedInBusinessId = Number(id);
                this.renderEntView(this.currentView);
                this.showToast(`Logado como: ${appData.businesses.find(b=>b.id == id).name}`, 'success');
            },

            renderEntView(view) {
                const b = appData.businesses.find(x => x.id === this.loggedInBusinessId);
                if(!b) return;

                if(view === 'overview') {
                    document.getElementById('ent-welcome-name').innerText = `Olá, ${b.name}!`;
                    document.getElementById('ent-stat-views').innerText = b.stats?.views || 0;
                    document.getElementById('ent-stat-contacts').innerText = b.stats?.contacts || 0;
                    
                    const badge = document.getElementById('ent-validation-status-badge');
                    if(b.validationStatus === 'pendente') badge.innerHTML = `<span class="bg-amber-100 text-amber-700 text-xs font-bold px-2 py-1 rounded">Aguardando Validação</span>`;
                    else badge.innerHTML = `<span class="bg-emerald-100 text-emerald-700 text-xs font-bold px-2 py-1 rounded">Cadastro Validado</span>`;

                    const adjAlert = document.getElementById('ent-adjustment-alert'), adjMsg = document.getElementById('ent-adjustment-message');
                    const pendingAdj = appData.validations.find(v => v.businessId === b.id && v.status === 'adjustment_requested');
                    if(pendingAdj) { adjAlert.classList.remove('hidden'); adjMsg.innerText = pendingAdj.feedback; } 
                    else adjAlert.classList.add('hidden');

                    const searchesHtml = (b.tags||[]).slice(0, 3).map((t, i) => `
                        <tr class="hover:bg-slate-50/50"><td class="px-6 py-3 font-medium text-slate-900">${t}</td><td class="px-6 py-3 text-slate-600">${Math.floor((b.stats?.views||0) / (i+2))}</td></tr>
                    `).join('');
                    document.getElementById('ent-top-searches').innerHTML = searchesHtml || '<tr><td colspan="2" class="p-4 text-center text-slate-500">Sem dados recentes</td></tr>';
                }

                if(view === 'vitrine') {
                    document.getElementById('edit-name').value = b.name;
                    document.getElementById('edit-category').value = b.category;
                    document.getElementById('edit-address').value = b.address;
                    document.getElementById('edit-type').value = b.type;
                    document.getElementById('edit-protected').checked = b.protectedLocation;
                    document.getElementById('edit-whatsapp').value = b.whatsapp;
                    document.getElementById('edit-status').value = b.status;
                    document.getElementById('edit-description').value = b.description;
                    
                    this.currentEditTags = [...(b.tags || [])];
                    this.renderTags('edit');
                    this.generateHoursUI('weekly-hours-container', b.hours);

                    document.getElementById('preview-name').innerText = b.name;
                    document.getElementById('preview-desc').innerText = b.description;
                }

                if(view === 'products') this.renderEntProducts(b);
            },

            saveProfileEdits() {
                const b = appData.businesses.find(x => x.id === this.loggedInBusinessId);
                const newName = document.getElementById('edit-name').value;
                const newCategory = document.getElementById('edit-category').value;
                const newAddress = document.getElementById('edit-address').value;
                const newType = document.getElementById('edit-type').value;

                if(newName !== b.name || newCategory !== b.category || newAddress !== b.address || newType !== b.type) {
                    appData.validations.push({
                        id: Date.now(), businessId: b.id, businessName: b.name, type: "Edição Cadastral (Core)",
                        changes: { name: { old: b.name, new: newName }, category: { old: b.category, new: newCategory }, address: { old: b.address, new: newAddress }, type: { old: b.type, new: newType } },
                        status: "pending", date: new Date().toISOString()
                    });
                    b.validationStatus = "pendente";
                }

                b.whatsapp = document.getElementById('edit-whatsapp').value;
                b.status = document.getElementById('edit-status').value;
                b.description = document.getElementById('edit-description').value;
                b.tags = [...this.currentEditTags];
                b.protectedLocation = document.getElementById('edit-protected').checked;
                b.hours = this.extractHoursData('weekly-hours-container');

                const adj = appData.validations.find(v => v.businessId === b.id && v.status === 'adjustment_requested');
                if(adj) adj.status = 'resolved';

                this.addHistory("Edição de Vitrine", b.name);
                storage.save();
                this.showToast('Alterações salvas! Dados sensíveis foram para validação.', 'success');
                this.navigate('entrepreneur', 'overview');
            },

            renderEntProducts(b) {
                const grid = document.getElementById('ent-products-grid');
                if(!b.catalog || b.catalog.length === 0) {
                    grid.innerHTML = `<div class="col-span-full p-8 text-center text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-200">Nenhum item adicionado.</div>`;
                    return;
                }
                grid.innerHTML = b.catalog.map(p => `
                    <div class="bg-white border border-slate-200 rounded-xl p-4 flex gap-4 shadow-sm group">
                        <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center flex-shrink-0 overflow-hidden"><img src="${p.img}" class="w-full h-full object-cover"></div>
                        <div class="flex-grow min-w-0">
                            <h4 class="font-bold text-slate-900 text-sm truncate">${p.name}</h4><span class="text-xs font-bold text-brand-600 mt-1 block">${p.price}</span>
                            <div class="flex gap-2 mt-3 opacity-0 group-hover:opacity-100 transition-opacity">
                                <button onclick="app.openProductModal(${p.id})" class="text-xs font-semibold text-slate-500 hover:text-brand-600">Editar</button>
                                <button onclick="app.deleteProduct(${p.id})" class="text-xs font-semibold text-slate-500 hover:text-red-600">Excluir</button>
                            </div>
                        </div>
                    </div>
                `).join('');
            },

            openProductModal(id = null) {
                const b = appData.businesses.find(x => x.id === this.loggedInBusinessId);
                const title = document.getElementById('modal-product-title');
                
                if(id) {
                    const p = b.catalog.find(x => x.id === id);
                    title.innerText = "Editar Item"; document.getElementById('prod-id').value = p.id;
                    document.getElementById('prod-name').value = p.name; document.getElementById('prod-price').value = p.price;
                } else {
                    title.innerText = "Novo Item"; document.getElementById('prod-id').value = '';
                    document.getElementById('prod-name').value = ''; document.getElementById('prod-price').value = '';
                }
                this.openModal('modal-product');
            },

            saveProduct() {
                const b = appData.businesses.find(x => x.id === this.loggedInBusinessId);
                const id = document.getElementById('prod-id').value, name = document.getElementById('prod-name').value.trim(), price = document.getElementById('prod-price').value.trim();
                if(!name) return this.showToast("Preencha o nome.", "error");

                if(id) {
                    const idx = b.catalog.findIndex(x => x.id == id);
                    if(idx > -1) { b.catalog[idx].name = name; b.catalog[idx].price = price; }
                } else {
                    const newId = b.catalog.length > 0 ? Math.max(...b.catalog.map(p => p.id)) + 1 : 1000;
                    b.catalog.push({ id: newId, name, price, img: "https://placehold.co/400x300/e2e8f0/475569?text=Novo" });
                }
                storage.save(); this.renderEntProducts(b); this.closeModal('modal-product'); this.showToast('Catálogo atualizado!', 'success');
            },

            deleteProduct(id) {
                const b = appData.businesses.find(x => x.id === this.loggedInBusinessId);
                b.catalog = b.catalog.filter(p => p.id !== id);
                storage.save(); this.renderEntProducts(b); this.showToast('Item excluído.', 'success');
            },

            renderMgrView(view) {
                if(view === 'overview') {
                    document.getElementById('mgr-stat-total').innerText = appData.businesses.length;
                    document.getElementById('mgr-stat-urban').innerText = appData.businesses.filter(b=>b.type==='urban').length;
                    document.getElementById('mgr-stat-prof').innerText = appData.businesses.filter(b=>b.type!=='urban').length;
                    document.getElementById('mgr-stat-gaps').innerText = appData.gaps.length;

                    const total = appData.businesses.length;
                    const valCount = appData.businesses.filter(b=>b.origin==='Vitrine Validada' || b.origin==='Cadastro Validado').length;
                    const impCount = appData.businesses.filter(b=>b.origin==='Base Importada' || b.origin==='Sincronizado PNAE').length;
                    const entCount = appData.businesses.filter(b=>b.origin==='Cadastro do Empreendedor' || b.origin==='Cadastro do Profissional').length;
                    document.getElementById('mgr-origin-validated').innerText = total ? Math.round((valCount/total)*100) + '%' : '0%';
                    document.getElementById('mgr-origin-imported').innerText = total ? Math.round((impCount/total)*100) + '%' : '0%';
                    document.getElementById('mgr-origin-entrepreneur').innerText = total ? Math.round((entCount/total)*100) + '%' : '0%';
                    
                    document.getElementById('mgr-dq-geo').innerText = '82%'; document.getElementById('mgr-dq-updated').innerText = '94%';

                    const segCount = {};
                    appData.businesses.forEach(b => { segCount[b.category] = (segCount[b.category] || 0) + 1; });
                    const colors = ['bg-brand-500', 'bg-emerald-500', 'bg-amber-500', 'bg-purple-500', 'bg-slate-500', 'bg-rose-500', 'bg-cyan-500'];
                    let colorIdx = 0;
                    document.getElementById('mgr-chart-segments').innerHTML = Object.entries(segCount).sort((a,b)=>b[1]-a[1]).slice(0,5).map(([cat, count]) => {
                        const pct = Math.round((count/total)*100); const c = colors[colorIdx++ % colors.length];
                        return `<div><div class="flex justify-between text-xs font-semibold text-slate-700 mb-1"><span>${cat}</span><span>${pct}%</span></div><div class="w-full bg-slate-100 rounded-full h-2"><div class="${c} h-2 rounded-full" style="width: ${pct}%"></div></div></div>`;
                    }).join('') || '<div class="text-sm text-slate-500">Sem dados.</div>';
                }

                if(view === 'base') this.renderBaseTable();

                if(view === 'gaps') {
                    const table = document.getElementById('mgr-gaps-table');
                    const gapsHtml = appData.gaps.sort((a,b)=>b.count-a.count).map(g => `
                        <tr class="hover:bg-slate-50/50"><td class="px-6 py-4 font-bold text-slate-900">${g.term}</td><td class="px-6 py-4"><span class="bg-slate-100 text-slate-700 px-2 py-1 rounded font-bold">${g.count}</span></td><td class="px-6 py-4"><span class="text-accent-600 font-semibold bg-accent-50 px-2 py-1 rounded border border-accent-100">${g.status}</span></td><td class="px-6 py-4 text-right"><button onclick="app.analyzeGap('${g.term}', ${g.count})" class="text-brand-600 font-semibold text-xs hover:underline">Analisar oportunidade</button></td></tr>
                    `).join('');
                    table.innerHTML = gapsHtml || '<tr><td colspan="4" class="p-6 text-center text-slate-500">Nenhuma lacuna registrada.</td></tr>';
                }

                if(view === 'demands') this.renderDemands();
                if(view === 'validations') this.renderValidations();
                if(view === 'history') this.renderHistory();
                if(view === 'impact') this.renderImpact();

                this.updateValidationsBadge();
            },

            renderBaseTable() {
                const search = document.getElementById('mgr-base-search').value.toLowerCase();
                const cat = document.getElementById('mgr-filter-category').value;
                const type = document.getElementById('mgr-filter-type').value;
                const status = document.getElementById('mgr-filter-status').value;
                const tbody = document.getElementById('mgr-base-table');
                
                let filtered = appData.businesses;
                if(cat) filtered = filtered.filter(b => b.category === cat);
                if(type) filtered = filtered.filter(b => b.type === type);
                if(status) {
                    if(status === 'ajuste') filtered = filtered.filter(b => appData.validations.some(v => v.businessId === b.id && v.status === 'adjustment_requested'));
                    else filtered = filtered.filter(b => b.validationStatus === status);
                }
                if(search) filtered = filtered.filter(b => b.name.toLowerCase().includes(search) || b.category.toLowerCase().includes(search) || (b.tags||[]).join(' ').toLowerCase().includes(search) || (b.cnae && b.cnae.includes(search)));

                document.getElementById('mgr-base-count').innerText = filtered.length;

                tbody.innerHTML = filtered.map(b => `
                    <tr class="hover:bg-slate-50/50">
                        <td class="px-6 py-4 cursor-pointer" onclick="app.openBaseDetails(${b.id})"><div class="font-bold text-slate-900 hover:text-brand-600">${b.name}</div><div class="text-xs text-slate-500">${b.cnae || 'S/ CNAE'}</div></td>
                        <td class="px-6 py-4 text-slate-600">${b.category}</td>
                        <td class="px-6 py-4"><div class="text-sm font-medium text-slate-900">${b.type === 'urban'?'Urbano':'Rural/Autônomo'}</div><div class="text-xs text-slate-500">${b.porte}</div></td>
                        <td class="px-6 py-4">${b.validationStatus === 'validado' ? '<span class="text-emerald-700 bg-emerald-50 px-2 py-1 rounded text-xs font-bold border border-emerald-100">Validado</span>' : '<span class="text-amber-700 bg-amber-50 px-2 py-1 rounded text-xs font-bold border border-amber-100">Pendente</span>'}</td>
                        <td class="px-6 py-4 text-center"><button onclick="app.viewProfileFromManager(${b.id})" class="text-brand-600 hover:text-brand-800 bg-brand-50 p-2 rounded-lg" title="Ver Vitrine"><i data-lucide="eye" class="w-4 h-4"></i></button></td>
                    </tr>
                `).join('');
                if(typeof lucide !== 'undefined') lucide.createIcons();
            },

            viewProfileFromManager(id) {
                this.switchPersona('citizen');
                this.openProfile(id);
            },

            openBaseDetails(id) {
                const b = appData.businesses.find(x => x.id === id);
                if(!b) return;
                document.getElementById('bd-name').innerText = b.name; document.getElementById('bd-category').innerText = b.category;
                document.getElementById('bd-cnae').innerText = b.cnae || '-'; document.getElementById('bd-porte').innerText = b.porte || 'N/A';
                document.getElementById('bd-origin').innerText = b.origin || 'Base'; document.getElementById('bd-address').innerText = b.address;
                const protBadge = document.getElementById('bd-protected');
                if(b.protectedLocation) protBadge.classList.remove('hidden'); else protBadge.classList.add('hidden');
                document.getElementById('bd-whatsapp').innerText = b.whatsapp || '-'; document.getElementById('bd-desc').innerText = b.description || '-';
                document.getElementById('bd-tags').innerText = (b.tags||[]).join(', ') || '-';
                let iconName = b.type === 'urban' ? 'store' : (b.type === 'rural' ? 'tractor' : 'user');
                document.getElementById('bd-icon').innerHTML = `<i data-lucide="${iconName}" class="w-6 h-6"></i>`;
                this.openModal('modal-base-details');
                if(typeof lucide !== 'undefined') lucide.createIcons();
            },

            saveDemand() {
                const title = document.getElementById('dem-title').value;
                const sector = document.getElementById('dem-sector').value;
                if(!title || !sector) return this.showToast("Preencha Título e Setor.", "error");

                appData.demands.push({
                    id: Date.now(), title, sector, 
                    category: document.getElementById('dem-cat').value,
                    tags: [...this.currentDemandTags],
                    cnae: document.getElementById('dem-cnae').value,
                    date: document.getElementById('dem-date').value,
                    desc: document.getElementById('dem-desc').value,
                    status: document.getElementById('dem-status').value
                });
                storage.save();
                this.closeModal('modal-new-demand');
                this.renderDemands();
                this.showToast("Demanda cadastrada com sucesso.", "success");
                this.currentDemandTags = [];
            },

            renderDemands() {
                const container = document.getElementById('mgr-demands-container');
                const empty = document.getElementById('mgr-demands-empty');
                
                if(appData.demands.length === 0) { container.innerHTML = ''; empty.classList.remove('hidden'); return; }
                empty.classList.add('hidden');

                container.innerHTML = appData.demands.map(d => {
                    // Match logic
                    const matches = appData.businesses.filter(b => {
                        if(b.validationStatus !== 'validado') return false;
                        if(d.cnae && b.cnae && b.cnae.includes(d.cnae)) return true;
                        if(d.category === b.category) return true;
                        const bTagsStr = (b.tags||[]).join(' ').toLowerCase();
                        return d.tags.some(t => bTagsStr.includes(t.toLowerCase()));
                    });

                    const color = d.category === 'Alimentação' ? 'emerald' : (d.category === 'Comércio' ? 'purple' : 'brand');
                    
                    return `
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 flex flex-col">
                            <div class="flex justify-between items-start mb-4">
                                <span class="bg-${color}-50 text-${color}-700 text-[10px] font-bold uppercase px-2.5 py-1 rounded-full border border-${color}-200">${d.sector}</span>
                                <span class="text-[10px] text-slate-500 font-bold bg-slate-100 px-2 py-1 rounded">${d.status}</span>
                            </div>
                            <h4 class="text-lg font-bold text-slate-900 mb-2">${d.title}</h4>
                            <p class="text-sm text-slate-600 mb-4 flex-grow">${d.desc}</p>
                            <div class="bg-slate-50 rounded-xl p-3 mb-4 border border-slate-100 text-center">
                                <span class="text-xs font-semibold text-slate-600 block mb-1">Oferta Local Relacionada:</span>
                                <span class="text-lg font-bold text-${color}-600">${matches.length} negócios</span>
                            </div>
                            <button onclick="app.searchFromManager('${(d.tags||[]).join(', ')}')" class="w-full bg-slate-900 text-white font-bold text-sm py-2.5 rounded-lg hover:bg-slate-800 transition shadow-sm">Ver oferta local relacionada</button>
                        </div>
                    `;
                }).join('');
            },

            renderValidations() {
                const container = document.getElementById('mgr-validations-container');
                const empty = document.getElementById('mgr-validations-empty');
                const pending = appData.validations.filter(v => v.status === 'pending');
                
                if(pending.length === 0) { container.innerHTML = ''; empty.classList.remove('hidden'); return; }
                empty.classList.add('hidden');

                container.innerHTML = pending.map(v => {
                    let diffs = '';
                    if(v.changes) {
                        for (const [field, vals] of Object.entries(v.changes)) {
                            if(vals.old !== vals.new) {
                                diffs += `<div class="grid grid-cols-2 gap-4 text-sm mt-2"><div class="bg-red-50 text-red-800 p-2 rounded border border-red-100"><strong class="capitalize">${field}:</strong> <del>${vals.old}</del></div><div class="bg-emerald-50 text-emerald-800 p-2 rounded border border-emerald-100"><strong>Novo:</strong> ${vals.new}</div></div>`;
                            }
                        }
                    }

                    return `
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                            <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start mb-4 border-b border-slate-100 pb-4 gap-4">
                                <div>
                                    <h4 class="text-lg font-bold text-slate-900">${v.businessName}</h4>
                                    <p class="text-xs text-slate-500 mt-1">Solicitação: <span class="font-bold text-slate-700">${v.type}</span> • Data: ${new Date(v.date).toLocaleDateString('pt-BR')}</p>
                                </div>
                                <div class="flex flex-wrap gap-2">
                                    <button onclick="app.prepareApproval(${v.id})" class="bg-emerald-500 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm flex items-center gap-1 transition"><i data-lucide="check" class="w-4 h-4"></i> Aprovar</button>
                                    <button onclick="app.openAdjustmentModal(${v.id})" class="bg-amber-100 text-amber-700 hover:bg-amber-200 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition">Pedir Ajuste</button>
                                    <button onclick="app.prepareRejection(${v.id})" class="bg-white border border-slate-300 text-slate-700 hover:bg-slate-50 px-3 py-1.5 rounded-lg text-xs font-bold shadow-sm transition">Rejeitar</button>
                                </div>
                            </div>
                            <div>
                                <h5 class="text-xs font-bold text-slate-500 uppercase tracking-wide">Detalhes da Solicitação</h5>
                                ${diffs || '<p class="text-sm text-slate-600 mt-2">Dados completos em análise.</p>'}
                                ${v.onboardingData && v.onboardingData.file ? `<button onclick="app.viewDocument('${v.onboardingData.file.name}', '${v.onboardingData.file.type}')" class="mt-3 text-brand-600 text-xs font-bold flex items-center gap-1 hover:underline"><i data-lucide="paperclip" class="w-4 h-4"></i> Ver Comprovante: ${v.onboardingData.file.name}</button>` : ''}
                            </div>
                        </div>
                    `;
                }).join('');
                if(typeof lucide !== 'undefined') lucide.createIcons();
            },

            prepareApproval(valId) {
                document.getElementById('appr-val-id').value = valId;
                this.openModal('modal-approve');
            },

            confirmApproveValidation() {
                const valId = Number(document.getElementById('appr-val-id').value);
                const v = appData.validations.find(x => x.id === valId);
                
                if(v.type === "Novo Cadastro") {
                    const d = v.onboardingData;
                    const newBiz = {
                        id: Date.now(), name: d.name, category: d.category, type: d.type, porte: d.porte, cnae: d.cnae, address: d.address, 
                        protectedLocation: d.protectedLocation, whatsapp: d.whatsapp, description: d.description, tags: d.tags, hours: d.hours,
                        status: "aberto", catalog: [], origin: "Cadastro Validado", validationStatus: "validado", updatedAt: new Date().toISOString().split('T')[0],
                        color: "bg-slate-700", icon: "store", stats: { views: 0, contacts: 0 }, lat: -25.2983, lng: -54.0933 // Default Medianeira
                    };
                    appData.businesses.push(newBiz);
                    this.loggedInBusinessId = newBiz.id;
                    this.updateBusinessSelector();
                } else if(v.businessId) {
                    const b = appData.businesses.find(x => x.id === v.businessId);
                    if(b) {
                        if(v.changes.name) b.name = v.changes.name.new;
                        if(v.changes.category) b.category = v.changes.category.new;
                        if(v.changes.address) b.address = v.changes.address.new;
                        if(v.changes.type) b.type = v.changes.type.new;
                        b.validationStatus = "validado"; b.updatedAt = new Date().toISOString().split('T')[0];
                    }
                }
                
                v.status = "approved";
                this.addHistory("Aprovação pelo Gestor", v.businessName);
                storage.save(); this.closeModal('modal-approve'); this.renderValidations(); this.updateValidationsBadge();
                this.showToast("Solicitação aprovada. Vitrine disponível no radar.", "success");
            },

            prepareRejection(valId) {
                document.getElementById('rej-val-id').value = valId;
                document.getElementById('rej-msg').value = '';
                this.openModal('modal-reject');
            },

            confirmRejectValidation() {
                const valId = Number(document.getElementById('rej-val-id').value);
                const msg = document.getElementById('rej-msg').value.trim();
                if(!msg) return this.showToast("Preencha o motivo da rejeição.", "error");

                const v = appData.validations.find(x => x.id === valId);
                v.status = "rejected"; v.feedback = msg;
                const b = appData.businesses.find(x => x.id === v.businessId);
                if(b) b.validationStatus = "validado"; // Revert to previous valid state if editing
                
                this.addHistory("Rejeição pelo Gestor", v.businessName);
                storage.save(); this.closeModal('modal-reject'); this.renderValidations(); this.updateValidationsBadge();
                this.showToast("Solicitação rejeitada.", "error");
            },

            openAdjustmentModal(valId) {
                document.getElementById('adj-val-id').value = valId; document.getElementById('adj-msg').value = '';
                this.openModal('modal-adjustment');
            },

            submitAdjustment() {
                const id = Number(document.getElementById('adj-val-id').value), msg = document.getElementById('adj-msg').value.trim();
                if(!msg) return this.showToast("Escreva o motivo.", "error");
                const v = appData.validations.find(x => x.id === id);
                v.status = "adjustment_requested"; v.feedback = msg;
                this.addHistory("Ajuste Solicitado", v.businessName);
                storage.save(); this.closeModal('modal-adjustment'); this.renderValidations(); this.updateValidationsBadge();
                this.showToast("Solicitação de ajuste enviada.", "success");
            },

            updateValidationsBadge() {
                const pendingCount = appData.validations.filter(v => v.status === 'pending').length;
                const badge = document.getElementById('mgr-badge-val');
                if(badge) {
                    if(pendingCount > 0) { badge.innerText = pendingCount; badge.classList.remove('hidden'); } 
                    else badge.classList.add('hidden');
                }
            },

            viewDocument(name, type) {
                document.getElementById('vdoc-name').innerText = name;
                document.getElementById('vdoc-type').innerText = type;
                this.openModal('modal-view-doc');
            },

            addHistory(action, detail) {
                appData.history.unshift({ date: new Date().toISOString(), user: app.currentPersona === 'manager' ? 'Gestor Municipal' : (app.currentPersona === 'entrepreneur' ? 'Empreendedor' : 'Sistema'), action: action, detail: detail });
                if(appData.history.length > 50) appData.history.pop();
            },

            renderHistory() {
                const container = document.getElementById('mgr-history-timeline');
                if(!container) return;
                container.innerHTML = appData.history.map(h => {
                    const date = new Date(h.date);
                    return `
                        <div class="relative">
                            <div class="absolute -left-[31px] bg-white border-2 border-slate-200 w-4 h-4 rounded-full mt-1"></div>
                            <div class="text-xs text-slate-400 font-semibold mb-1">${date.toLocaleDateString('pt-BR')} às ${date.toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})}</div>
                            <div class="bg-slate-50 border border-slate-100 p-3 rounded-lg text-sm"><span class="font-bold text-slate-800">${h.user}:</span> <span class="font-medium text-slate-700">${h.action}</span> - <span class="text-slate-500">${h.detail}</span></div>
                        </div>
                    `;
                }).join('');
            },

            renderImpact() {
                document.getElementById('imp-demand-count').innerText = appData.demands.length;
                let matches = 0;
                appData.demands.forEach(d => {
                    const m = appData.businesses.filter(b => b.validationStatus==='validado' && ((d.cnae && b.cnae && b.cnae.includes(d.cnae)) || d.category === b.category));
                    if(m.length>0) matches++;
                });
                document.getElementById('imp-demand-matched').innerText = matches;
                document.getElementById('imp-biz-matched').innerText = appData.businesses.length; // Simplified for demo
            },

            openExecutiveReport() {
                document.getElementById('rep-total').innerText = appData.businesses.length;
                document.getElementById('rep-urban').innerText = appData.businesses.filter(b=>b.type==='urban').length;
                document.getElementById('rep-rural').innerText = appData.businesses.filter(b=>b.type!=='urban').length;
                document.getElementById('rep-geo').innerText = '82%';
                document.getElementById('rep-gaps').innerText = appData.gaps.slice(0,3).map(g=>g.term).join(', ') || 'Nenhuma';
                this.openModal('modal-executive-report');
            },

            analyzeGap(term, count) {
                document.getElementById('gap-modal-term').innerText = term;
                document.getElementById('gap-modal-count').innerText = count;
                this.openModal('modal-gap-analysis');
            },

            searchFromManager(term) {
                this.switchPersona('citizen');
                this.forceSearch(term);
            },

            initMgrMap() {
                if(this.mgrLeafletMap) { this.mgrLeafletMap.invalidateSize(); return; }
                this.mgrLeafletMap = L.map('mgr-map', {zoomControl: false}).setView([-25.2983, -54.0933], 13);
                L.control.zoom({ position: 'bottomleft' }).addTo(this.mgrLeafletMap);
                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', { attribution: '&copy; OSM', subdomains: 'abcd', maxZoom: 19 }).addTo(this.mgrLeafletMap);

                appData.businesses.forEach(b => {
                    let iconName = b.type === 'urban' ? 'store' : (b.type === 'rural' ? 'tractor' : 'user');
                    if(!b.protectedLocation) {
                        const customIcon = L.divIcon({
                            className: 'custom-div-icon',
                            html: `<div class="w-8 h-8 ${b.color} rounded-full flex items-center justify-center text-white shadow-md border-2 border-white"><i data-lucide="${iconName}" class="w-4 h-4"></i></div>`,
                            iconSize: [32, 32], iconAnchor: [16, 32], popupAnchor: [0, -32]
                        });
                        const marker = L.marker([b.lat, b.lng], {icon: customIcon}).addTo(this.mgrLeafletMap);
                        marker.bindPopup(`<div class="p-2"><p class="text-[10px] font-bold text-slate-400 uppercase mb-1">${b.category}</p><h4 class="font-bold text-slate-900 text-sm">${b.name}</h4><button onclick="app.viewProfileFromManager(${b.id})" class="mt-2 text-brand-600 text-xs font-bold underline">Ver vitrine</button></div>`);
                    } else {
                        const circle = L.circle([b.lat, b.lng], { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.2, radius: 200, weight: 2 }).addTo(this.mgrLeafletMap);
                        circle.bindPopup(`<div class="p-2"><p class="text-[10px] font-bold text-slate-400 uppercase mb-1">${b.category}</p><h4 class="font-bold text-slate-900 text-sm">${b.name}</h4><p class="text-xs text-emerald-600 font-bold mt-1">Localização aproximada</p></div>`);
                    }
                });
                setTimeout(() => { if(typeof lucide !== 'undefined') lucide.createIcons(); }, 50);
            },

            simulateExport() { this.showToast('Download do documento iniciado.', 'success'); },
            
            showToast(message, type = 'success') {
                const container = document.getElementById('toast-container');
                if(!container) return;
                const toast = document.createElement('div');
                const bgColor = type === 'success' ? 'bg-emerald-600' : (type === 'error' ? 'bg-red-600' : 'bg-slate-800');
                const icon = type === 'success' ? 'check-circle' : (type === 'error' ? 'alert-circle' : 'info');
                
                toast.className = `toast ${bgColor}`;
                toast.innerHTML = `<i data-lucide="${icon}" class="w-5 h-5"></i> ${message}`;
                container.appendChild(toast);
                if(typeof lucide !== 'undefined') lucide.createIcons();
                
                setTimeout(() => {
                    toast.style.animation = 'slideInRight 0.3s ease-in reverse forwards';
                    setTimeout(() => toast.remove(), 300);
                }, 3000);
            },

            isValidCPF(cpf) {
                if (/^(\d)\1+$/.test(cpf)) return false;
                let sum = 0, rest;
                for (let i = 1; i <= 9; i++) sum += parseInt(cpf.substring(i-1, i)) * (11 - i);
                rest = (sum * 10) % 11;
                if ((rest === 10) || (rest === 11)) rest = 0;
                if (rest !== parseInt(cpf.substring(9, 10))) return false;
                sum = 0;
                for (let i = 1; i <= 10; i++) sum += parseInt(cpf.substring(i-1, i)) * (12 - i);
                rest = (sum * 10) % 11;
                if ((rest === 10) || (rest === 11)) rest = 0;
                if (rest !== parseInt(cpf.substring(10, 11))) return false;
                return true;
            }
        };

        const vitoriaAssistant = {
            isOpen: false,
            
            init() {
                this.renderGreeting();
                this.updateQuickReplies();
            },

            toggle() {
                this.isOpen ? this.close() : this.open();
            },

            open() {
                const chat = document.getElementById('vitoria-chat');
                chat.classList.remove('hidden-chat');
                this.isOpen = true;
                setTimeout(() => document.getElementById('vitoria-input').focus(), 300);
                this.scrollToBottom();
            },

            close() {
                document.getElementById('vitoria-chat').classList.add('hidden-chat');
                this.isOpen = false;
            },

            updateContext(persona) {
                this.renderGreeting();
                this.updateQuickReplies();
                if (this.isOpen) {
                    this.addBotMessage(`Notei que você mudou para o perfil de <b>${persona === 'citizen' ? 'Cidadão' : persona === 'manager' ? 'Gestor' : 'Empreendedor'}</b>. Como posso ajudar agora?`);
                }
            },

            renderGreeting() {
                const msgs = document.getElementById('vitoria-messages');
                msgs.innerHTML = '';
                let text = "";
                if(app.currentPersona === 'citizen') text = "Olá! Sou a Vitória. Posso te ajudar a encontrar os melhores produtos e profissionais aqui em Medianeira. O que você precisa hoje?";
                if(app.currentPersona === 'manager') text = "Olá, Gestor! Sou a Vitória. Estou conectada à base econômica do município. Posso gerar resumos de lacunas, qualificação da base ou localizar fornecedores.";
                if(app.currentPersona === 'entrepreneur') text = "Olá! Sou a Vitória. Posso te ajudar a gerenciar sua vitrine digital e mostrar indicadores de visitas e buscas.";
                
                this.addBotMessage(text, false);
            },

            updateQuickReplies() {
                const container = document.getElementById('vitoria-quick-replies');
                let replies = [];
                
                if(app.currentPersona === 'citizen') {
                    replies = ["Preciso de uma manicure", "Quem conserta celular?", "Onde tem produtos rurais?"];
                } else if(app.currentPersona === 'manager') {
                    replies = ["Quais são as maiores lacunas?", "Como está a qualidade da base?", "Temos fornecedores para merenda?"];
                } else {
                    replies = ["Como está minha vitrine?", "Meu cadastro está validado?", "A Prefeitura pediu correção?"];
                }

                container.innerHTML = replies.map(r => `
                    <button onclick="vitoriaAssistant.sendPresetMessage('${r}')" class="px-3 py-1.5 bg-white border border-brand-200 text-brand-700 hover:bg-brand-50 rounded-full text-xs font-semibold whitespace-nowrap shadow-sm transition-colors flex-shrink-0">
                        ${r}
                    </button>
                `).join('');
            },

            sendPresetMessage(text) {
                document.getElementById('vitoria-input').value = text;
                this.sendUserMessage();
            },

            sendUserMessage() {
                const input = document.getElementById('vitoria-input');
                const text = input.value.trim();
                if(!text) return;

                this.addUserMessage(text);
                input.value = '';

                const typingId = this.addTypingIndicator();
                
                setTimeout(() => {
                    const typingEl = document.getElementById(typingId);
                    if(typingEl) typingEl.remove();
                    this.processCommand(text);
                }, 800);
            },

            addUserMessage(text) {
                const msgs = document.getElementById('vitoria-messages');
                msgs.insertAdjacentHTML('beforeend', `
                    <div class="self-end max-w-[85%] chat-bubble-user px-4 py-2.5 shadow-sm text-sm">
                        ${text}
                    </div>
                `);
                this.scrollToBottom();
            },

            addBotMessage(html, animate = true) {
                const msgs = document.getElementById('vitoria-messages');
                msgs.insertAdjacentHTML('beforeend', `
                    <div class="self-start max-w-[85%] chat-bubble-bot px-4 py-2.5 shadow-sm text-sm ${animate ? 'animate-[fadeIn_0.3s_ease-out]' : ''}">
                        ${html}
                    </div>
                `);
                this.scrollToBottom();
                if(typeof lucide !== 'undefined') lucide.createIcons();
            },

            addTypingIndicator() {
                const id = 'typing-' + Date.now();
                const msgs = document.getElementById('vitoria-messages');
                msgs.insertAdjacentHTML('beforeend', `
                    <div id="${id}" class="self-start chat-bubble-bot px-4 py-3 shadow-sm text-sm flex gap-1">
                        <div class="w-1.5 h-1.5 bg-brand-400 rounded-full animate-bounce"></div>
                        <div class="w-1.5 h-1.5 bg-brand-400 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
                        <div class="w-1.5 h-1.5 bg-brand-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                    </div>
                `);
                this.scrollToBottom();
                return id;
            },

            scrollToBottom() {
                const msgs = document.getElementById('vitoria-messages');
                msgs.scrollTop = msgs.scrollHeight;
            },

            processCommand(text) {
                const lower = text.toLowerCase();
                const p = app.currentPersona;

                if (p === 'manager') {
                    if(lower.includes("lacuna") || lower.includes("falta") || lower.includes("procurados")) {
                        let html = "Identifiquei estas <b>lacunas de oferta</b> na base:<br><br>";
                        appData.gaps.slice(0,3).forEach(g => { html += `• <b>${g.term}</b> (${g.count} buscas)<br>`; });
                        return this.addBotMessage(html);
                    }
                    if(lower.includes("qualidade") || lower.includes("auditoria")) {
                        const total = appData.businesses.length;
                        const valid = appData.businesses.filter(b=>b.validationStatus === 'validado').length;
                        const pct = total > 0 ? Math.round((valid/total)*100) : 0;
                        return this.addBotMessage(`Atualmente, nossa base possui <b>${total} cadastros</b>. Destes, <b>${pct}% estão com a vitrine pública validada</b> pela gestão municipal.`);
                    }
                    if(lower.includes("pendente") || lower.includes("aprovar")) {
                        const pend = appData.validations.filter(v=>v.status === 'pending').length;
                        return this.addBotMessage(`Existem <b>${pend} solicitações pendentes</b> de aprovação ou alteração na fila de validação.`);
                    }
                    if(lower.includes("mei") || lower.includes("empresa") || lower.includes("alimentação") || lower.includes("setor")) {
                        return this.addBotMessage(`Temos <b>${appData.businesses.length} negócios</b> na base. Para recortes específicos, sugiro acessar a visão de <b>Base Econômica</b> e utilizar os filtros!`);
                    }
                    if(lower.includes("merenda") || lower.includes("demanda") || lower.includes("fornecedor")) {
                        return this.addBotMessage(`Para analisar potenciais fornecedores locais, verifique o painel <b>Demandas Públicas</b>. Lá eu faço o cruzamento automático dos CNAEs e palavras-chave da base com a necessidade pública.`);
                    }
                    return this.addBotMessage("Estou conectada à base. Pergunte-me sobre lacunas, qualidade da base, pendências ou quantitativos gerais.");
                }

                if (p === 'entrepreneur') {
                    const b = appData.businesses.find(x => x.id === app.loggedInBusinessId);
                    if(lower.includes("correção") || lower.includes("prefeitura pediu") || lower.includes("ajuste")) {
                        const adj = appData.validations.find(v => v.businessId === b.id && v.status === 'adjustment_requested');
                        if(adj) {
                            return this.addBotMessage(`Sim! O gestor municipal solicitou um ajuste: <br><br><i>"${adj.feedback}"</i><br><br>Por favor, edite sua vitrine para corrigir.`);
                        }
                        return this.addBotMessage(`Sua situação está regular. Não há pedidos de correção pendentes da Prefeitura no momento.`);
                    }
                    if(lower.includes("vitrine") || lower.includes("melhorar") || lower.includes("validado")) {
                        let statusText = b.validationStatus === 'validado' ? 'está <b>Validada</b> publicamente.' : 'está <b>Aguardando Validação</b> da prefeitura.';
                        return this.addBotMessage(`Sua vitrine, <b>${b.name}</b>, ${statusText} Lembre-se de manter seu catálogo sempre atualizado para atrair mais buscas.`);
                    }
                    if(lower.includes("desempenho") || lower.includes("visita") || lower.includes("buscas")) {
                        return this.addBotMessage(`Nos últimos 30 dias, você apareceu <b>${b.stats?.views || 0} vezes</b> no Radar Municipal e recebeu <b>${b.stats?.contacts || 0} cliques</b> no botão do seu WhatsApp!`);
                    }
                    return this.addBotMessage("Posso te passar o status do seu cadastro, pedidos de correção da prefeitura ou os indicadores da sua loja. O que deseja saber?");
                }

                if(lower.includes("olá") || lower.includes("oi") || lower.includes("bom dia")) {
                    return this.addBotMessage("Olá! O que você está buscando em Medianeira hoje? (ex: encanador, marcenaria, mel)");
                }

                const results = app.searchEngine(text);
                if(results.length > 0) {
                    let html = `Encontrei <b>${results.length} resultados</b> para você! Aqui está o destaque:<br><br>`;
                    const bestMatch = results[0];
                    let iconName = bestMatch.type === 'urban' ? 'store' : (bestMatch.type === 'rural' ? 'tractor' : 'user');
                    
                    html += `
                        <div class="bg-white border border-slate-200 rounded-xl p-3 shadow-sm mb-3">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 rounded-lg ${bestMatch.color} text-white flex items-center justify-center"><i data-lucide="${iconName}" class="w-5 h-5"></i></div>
                                <div>
                                    <h4 class="font-bold text-slate-900 leading-tight">${bestMatch.name}</h4>
                                    <span class="text-[10px] text-slate-500 uppercase">${bestMatch.category}</span>
                                </div>
                            </div>
                            <button onclick="app.switchPersona('citizen'); app.openProfile(${bestMatch.id}); vitoriaAssistant.close()" class="w-full bg-brand-50 text-brand-700 hover:bg-brand-100 border border-brand-200 py-1.5 rounded-lg text-xs font-bold transition">Ver Vitrine</button>
                        </div>
                    `;

                    if(results.length > 1) {
                        html += `<button onclick="app.forceSearch('${text}'); vitoriaAssistant.close()" class="w-full bg-slate-900 text-white py-2 rounded-lg font-semibold text-xs mt-1 hover:bg-slate-800 transition shadow-sm">Ver todos no Radar</button>`;
                    }
                    this.addBotMessage(html);
                } else {
                    app.addGapToManager(text);
                    this.addBotMessage(`Poxa, ainda não encontrei negócios validados para <b>"${text}"</b>. Mas não se preocupe: acabei de registrar essa falta no painel da Prefeitura para que eles possam atrair profissionais dessa área!`);
                }
            }
        };

        // Init App globally
        window.app = app;
        window.vitoriaAssistant = vitoriaAssistant;
        window.addEventListener('DOMContentLoaded', () => { app.init(); });
    </script>
</body>
</html>